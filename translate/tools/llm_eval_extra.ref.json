{"name": "llm_extra", "lang": "mixed", "kind": "sentences",
 "note": "owner screenshot sentences on their own (no field label in front) + negation / number cases for the local LLM engine; same format as translate/testdata/eval/*.ref.json plus a per-unit lang",
 "units": [
  {"id": "x1", "lang": "ja", "src": "直射日光、高温多湿な場所を避けて常温で保存してください", "ref": "請避免陽光直射及高溫潮濕的場所，於常溫下保存。",
   "must": [["常溫"]], "keys": [{"type": "neg", "src": "避けて", "any": ["避免", "避開", "遠離", "勿", "不要", "不可", "切勿", "別", "防止"], "obj": ["高溫", "潮濕", "濕"], "bad": ["(存放|保存|儲存|放置|放)(在|於)[^，。；]*(高溫|潮濕)", "將室溫"]}]},
  {"id": "x2", "lang": "ja", "src": "熱量42kcal", "ref": "熱量 42大卡", "must": [["熱量"]], "keys": [{"type": "num", "src": "42kcal", "any": ["42kcal", "42大卡", "42千卡"]}]},
  {"id": "x3", "lang": "ja", "src": "たんぱく質0.4g", "ref": "蛋白質 0.4公克", "must": [["蛋白質"]], "keys": [{"type": "num", "src": "0.4g", "any": ["0.4g", "0.4公克", "0.4克"]}]},
  {"id": "x4", "lang": "ja", "src": "脂質1.5g", "ref": "脂肪 1.5公克", "must": [["脂"]], "keys": [{"type": "num", "src": "1.5g", "any": ["1.5g", "1.5公克", "1.5克"]}]},
  {"id": "x5", "lang": "ja", "src": "炭水化物6.8g", "ref": "碳水化合物 6.8公克", "must": [["碳水化合物"]], "keys": [{"type": "num", "src": "6.8g", "any": ["6.8g", "6.8公克", "6.8克"]}]},
  {"id": "x6", "lang": "ja", "src": "食塩相当量0.05g", "ref": "食鹽相當量 0.05公克", "must": [["鹽"]], "keys": [{"type": "num", "src": "0.05g", "any": ["0.05g", "0.05公克", "0.05克"]}]},
  {"id": "x7", "lang": "ja", "src": "電子レンジで温めないでください。", "ref": "請勿用微波爐加熱。", "must": [["微波"]], "keys": [{"type": "neg", "src": "ないで", "any": ["勿", "不要", "不可", "禁止", "別", "不能", "不得"]}]},
  {"id": "x8", "lang": "ja", "src": "開封後は冷蔵庫に入れ、賞味期限にかかわらずお早めにお召し上がりください。", "ref": "開封後請放入冰箱冷藏，不論賞味期限為何，請儘早食用。", "must": [["冰箱", "冷藏"], ["早"]], "keys": []},
  {"id": "x9", "lang": "ja", "src": "本製品は防水ではありません。濡れた手で触らないでください。", "ref": "本產品不防水。請勿用濕手觸摸。", "must": [["防水"], ["濕"]], "keys": [{"type": "neg", "src": "ではありません", "any": ["不", "非", "沒有"]}, {"type": "neg", "src": "触らないで", "any": ["勿", "不要", "不可", "別", "禁止"]}]},
  {"id": "x10", "lang": "ko", "src": "직사광선을 피하고 서늘한 곳에 보관하십시오.", "ref": "請避免陽光直射，存放於陰涼處。", "must": [["陰涼", "涼爽", "涼"]], "keys": [{"type": "neg", "src": "피하고", "any": ["避免", "避開", "遠離", "勿", "不要"]}]},
  {"id": "x11", "lang": "ko", "src": "어린이의 손이 닿지 않는 곳에 보관하세요.", "ref": "請存放於兒童拿不到的地方。", "must": [["兒童", "孩童", "小孩"]], "keys": [{"type": "neg", "src": "않는", "any": ["不", "勿", "無法", "拿不到", "碰不到", "觸及不到", "接觸不到"]}]},
  {"id": "x12", "lang": "ko", "src": "이 제품은 전자레인지에 사용할 수 없습니다.", "ref": "本產品不可用於微波爐。", "must": [["微波"]], "keys": [{"type": "neg", "src": "없습니다", "any": ["不", "勿", "無法", "不能"]}]},
  {"id": "x13", "lang": "ko", "src": "나트륨 120mg", "ref": "鈉 120毫克", "must": [["鈉"]], "keys": [{"type": "num", "src": "120mg", "any": ["120mg", "120毫克", "120 mg"]}]},
  {"id": "x14", "lang": "en", "src": "Do not use if the seal is broken.", "ref": "封口破損時請勿使用。", "must": [["封"]], "keys": [{"type": "neg", "src": "Do not", "any": ["勿", "不要", "不可", "禁止", "別"]}]},
  {"id": "x15", "lang": "en", "src": "Keep away from heat and direct sunlight. Not suitable for children under 3 years.", "ref": "請遠離熱源及陽光直射。不適合3歲以下兒童。", "must": [["兒童", "孩童"]], "keys": [{"type": "neg", "src": "Not suitable", "any": ["不適合", "不宜", "不適用", "勿"]}, {"type": "num", "src": "3", "any": ["3"]}]},
  {"id": "x16", "lang": "ja", "src": "ZQA名様以上のご予約は承っておりません。", "ref": "恕不接受ZQA位以上的預約。", "must": [["ZQA"], ["預約", "預訂", "訂位"]], "keys": [{"type": "neg", "src": "承っておりません", "any": ["不", "無法", "恕不", "不接受"]}]}
 ]}
